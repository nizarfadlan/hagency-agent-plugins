#!/bin/sh
set -eu
package_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
repo_root=$(CDPATH= cd -- "$package_root/../.." && pwd)
for binary in \
    "$package_root/target/release/herdr-runtime" \
    "$package_root/target/debug/herdr-runtime" \
    "$repo_root/target/release/herdr-runtime" \
    "$repo_root/target/debug/herdr-runtime"
do
    if [ -x "$binary" ]; then
        exec "$binary" "$@"
    fi
done
printf '%s\n' 'herdr-runtime is not built; run cargo build --release in the package root' >&2
exit 127
